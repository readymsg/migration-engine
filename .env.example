APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Engine-specific external services ────────────────────────────────
# Set locally (never commit real values); set on Forge via the site's
# Environment tab.

# Anthropic API — LLM stages (block-fill Sonnet, IR-pass Opus, classify Haiku).
ANTHROPIC_API_KEY=

# Firecrawl — content scraping during INGEST.
FIRECRAWL_API_KEY=

# Which filesystem disk ContentLoader reads scrapes from. Local dev:
# `local` (storage/app). Prod on a single Forge box: `local` also works.
# Multi-server would need `s3`.
SCRAPES_DISK=local

# ─── Hosted-demo cost-safety layer (LOAD-BEARING when public) ─────────
# See CLAUDE.md's "Hosted demo" section for the full model.

# Shared secret sent as X-Demo-Token by the landing-page JS.
# CLIENT-VISIBLE (embedded in the HTML). Not a real secret; cost is
# bounded by the allowlist + budget cap below, not by token secrecy.
DEMO_TOKEN=

# Comma-separated allowlist of URLs the demo will convert. Empty in
# dev/local (all URLs allowed). Non-empty in hosted demo (Level 2 gate).
# Matches after lowercase + trim + trailing-slash normalization.
DEMO_URL_ALLOWLIST=

# Daily spend ceiling in USD. Cache-backed counter increments ~$4 per
# fresh conversion. When exceeded, POST returns 429 until UTC midnight.
DEMO_DAILY_BUDGET_USD=30

# In-flight concurrency cap. Second POST while another is running gets
# 409 (dedupe hits still succeed — they don't count as "another").
DEMO_CONCURRENT_CONVERSIONS=1

# When set to 1, replaces the real AnthropicBlockFillAgent with a
# fixture-replaying stub. Used only by the Tier-4 async validation
# harness. MUST BE UNSET in production.
BLOCKFILL_FIXTURE_REPLAY=
